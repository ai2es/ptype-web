# Default server configuration
#

upstream flaskptype {
    server 127.0.0.1:8000;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html/ptype/frontend/build;
    index index.html;

    server_name _;

    location / {
        try_files $uri $uri/ /index.html; # Serve React app index.html for all routes
    }

    location /testing {

        proxy_pass http://flaskptype; # Proxy requests to Gunicorn for Flask API routes
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /getCSV {

        proxy_pass http://flaskptype; # Proxy requests to Gunicorn for Flask API routes
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        proxy_pass http://flaskptype;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /modSounding {

        proxy_pass http://flaskptype; # Proxy requests to Gunicorn for Flask API routes
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /retrieveValue {

        proxy_pass http://flaskptype; # Proxy requests to Gunicorn for Flask API routes
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
