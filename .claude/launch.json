{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ptype-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5183",
        "--strictPort"
      ],
      "port": 5183
    },
    {
      "name": "ptype-web-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_BASE=/ptype-web/",
        "npm",
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "5184",
        "--strictPort"
      ],
      "port": 5184
    }
  ]
}