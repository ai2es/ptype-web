# Copy to .env.local and fill in. Left blank, forecasts and soundings are read
# from the wwe-ptype bucket and the model from public/. A value may be an
# absolute URL or a path inside the site, e.g. sample-data/ptype and
# sample-data/soundings.zarr for the sample data.
VITE_PTYPE_URL=
VITE_SOUNDING_URL=
VITE_MODEL_URL=
VITE_MODEL_META_URL=
VITE_HRRR_URL=
# Set when deploying under a fixed absolute path, e.g. /ptype-web/
# VITE_BASE=
